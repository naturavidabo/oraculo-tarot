{
  "name": "oraculo-tarot-pwa",
  "private": true,
  "version": "1.0.0-beta.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.app.json --pretty false && tsc -p tsconfig.node.json --pretty false",
    "validate:content": "node scripts/validate-content.mjs",
    "syntax:check": "npm run typecheck",
    "smoke:selector": "node scripts/smoke-selector.cjs",
    "smoke:engine": "node scripts/smoke-engine.cjs",
    "validate:combinations": "node scripts/validate-combinations.mjs",
    "test:core": "npm run release:audit && npm run validate:content && npm run validate:combinations && npm run validate:images && npm run validate:spanish-ui && npm run validate:beta && npm run validate:pages && npm run smoke:selector && npm run smoke:engine",
    "release:audit": "node scripts/release-audit.mjs",
    "validate:pages": "node scripts/validate-pages.mjs",
    "build:strict": "npm run typecheck && vite build",
    "validate:images": "node scripts/validate-image-manifest.mjs",
    "fetch:cards": "node scripts/fetch-card-images.mjs",
    "validate:card-assets": "node scripts/validate-card-assets.mjs",
    "validate:spanish-ui": "node scripts/validate-spanish-ui.mjs",
    "postinstall": "node scripts/fetch-card-images.mjs && node scripts/validate-card-assets.mjs",
    "prebuild": "node scripts/fetch-card-images.mjs && node scripts/validate-card-assets.mjs",
    "validate:beta": "node scripts/validate-beta-features.mjs"
  },
  "dependencies": {
    "dexie": "4.4.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "typescript": "7.0.2",
    "vite": "8.1.5",
    "vite-plugin-pwa": "1.3.0"
  }
}
