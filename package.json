{
  "name": "oraculo-tarot-pwa",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "validate:content": "node scripts/validate-content.mjs",
    "syntax:check": "node scripts/syntax-check.cjs",
    "smoke:selector": "node scripts/smoke-selector.cjs",
    "smoke:engine": "node scripts/smoke-engine.cjs",
    "validate:combinations": "node scripts/validate-combinations.mjs",
    "test:core": "npm run validate:content && npm run validate:combinations && npm run validate:pages && npm run syntax:check && npm run smoke:selector && npm run smoke:engine",
    "validate:pages": "node scripts/validate-pages.mjs"
  },
  "dependencies": {
    "dexie": "4.4.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "typescript": "7.0.2",
    "vite": "8.1.5",
    "vite-plugin-pwa": "1.3.0"
  }
}
